[Unit]
Description=Aqua Atmos Dashboard
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/aqua-atmos-ai/app
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/pi/aqua-atmos-ai/.venv/bin/python main.py
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
